{
  "name": "gtm-content-videos",
  "version": "1.0.0",
  "description": "API integrations for ElevenLabs and HeyGen",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "remotion render src/Video.jsx MyComp out/video.mp4",
    "preview": "remotion preview src/Video.jsx",
    "upgrade": "remotion upgrade",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.438",
    "@remotion/player": "^4.0.438",
    "@remotion/renderer": "^4.0.438",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "dotenv-safe": "^9.1.0",
    "jest": "^30.3.0",
    "joi": "^18.0.2",
    "remotion": "^4.0.438",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.0.0",
    "prettier": "^3.8.1"
  }
}
